<RCC>
    <!-- LyCAD 界面资源。
         图标以 SVG 源文件保存：同一枚图标要在 16 / 24 / 32 像素下使用，
         矢量源在每种尺寸下都清晰，体积也比多套 PNG 小。
         深色主题下的配色由 ui/IconLibrary 在读取源码后替换调色板实现。 -->
    <qresource prefix="/icons">
        <file alias="arc.svg">icons/arc.svg</file>
        <file alias="circle.svg">icons/circle.svg</file>
        <file alias="color.svg">icons/color.svg</file>
        <file alias="copy.svg">icons/copy.svg</file>
        <file alias="dim-aligned.svg">icons/dim-aligned.svg</file>
        <file alias="dim-arc.svg">icons/dim-arc.svg</file>
        <file alias="dim-diameter.svg">icons/dim-diameter.svg</file>
        <file alias="dim-linear.svg">icons/dim-linear.svg</file>
        <file alias="dim-ordinate.svg">icons/dim-ordinate.svg</file>
        <file alias="dim-radius.svg">icons/dim-radius.svg</file>
        <file alias="ellipse.svg">icons/ellipse.svg</file>
        <file alias="erase.svg">icons/erase.svg</file>
        <file alias="explode.svg">icons/explode.svg</file>
        <file alias="grid.svg">icons/grid.svg</file>
        <file alias="hatch.svg">icons/hatch.svg</file>
        <file alias="help.svg">icons/help.svg</file>
        <file alias="layer.svg">icons/layer.svg</file>
        <file alias="line.svg">icons/line.svg</file>
        <file alias="linetype.svg">icons/linetype.svg</file>
        <file alias="lineweight.svg">icons/lineweight.svg</file>
        <file alias="mirror.svg">icons/mirror.svg</file>
        <file alias="move.svg">icons/move.svg</file>
        <file alias="mtext.svg">icons/mtext.svg</file>
        <file alias="new.svg">icons/new.svg</file>
        <file alias="open.svg">icons/open.svg</file>
        <file alias="ortho.svg">icons/ortho.svg</file>
        <file alias="point.svg">icons/point.svg</file>
        <file alias="polyline.svg">icons/polyline.svg</file>
        <file alias="print.svg">icons/print.svg</file>
        <file alias="properties.svg">icons/properties.svg</file>
        <file alias="ray.svg">icons/ray.svg</file>
        <file alias="rectangle.svg">icons/rectangle.svg</file>
        <file alias="redo.svg">icons/redo.svg</file>
        <file alias="rotate.svg">icons/rotate.svg</file>
        <file alias="save.svg">icons/save.svg</file>
        <file alias="scale.svg">icons/scale.svg</file>
        <file alias="select-all.svg">icons/select-all.svg</file>
        <file alias="snap.svg">icons/snap.svg</file>
        <file alias="table.svg">icons/table.svg</file>
        <file alias="text.svg">icons/text.svg</file>
        <file alias="theme-dark.svg">icons/theme-dark.svg</file>
        <file alias="undo.svg">icons/undo.svg</file>
        <file alias="xline.svg">icons/xline.svg</file>
        <file alias="zoom-extents.svg">icons/zoom-extents.svg</file>
        <file alias="zoom-selection.svg">icons/zoom-selection.svg</file>
    </qresource>
</RCC>
