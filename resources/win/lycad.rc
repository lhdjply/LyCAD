// =============================================================================
//  LyCAD - resources/win/lycad.rc
//  Windows 可执行文件的图标资源。
//
//  只有 Windows 需要这一步：资源管理器与任务栏读的是 PE 资源段里的图标，
//  而不是 Qt 资源。其余平台靠两样东西就够了——
//    · 窗口 / 对话框图标：qrc 里的 resources/app/app-icon.svg（见 ui/IconLibrary）；
//    · 桌面 / 菜单图标：安装到 hicolor 主题目录的 PNG（见 CMakeLists 的安装规则）。
//
//  资源 ID 用数字而非 IDI_ICON1：rc.exe 与 windres 都认，且不依赖 windows.h。
// =============================================================================
101 ICON "../app/lycad.ico"
